    "firstName": { "locator": "input[id*='LSI_CLPAssistantDirectorFirstName_']", "type": "text" },
    "middleInitial": { "locator": "input[id*='LSI_CLPAssistantDirectorMiddleInitial_']", "type": "text" },
    "lastName": { "locator": "input[id*='LSI_CLPAssistantDirectorLastName_']", "type": "text" },
    "cqCode": { "locator": "input[id*='LSI_CLPAssistantDirectorCQcode_']", "type": "text" },
    "verifyButton": { "locator": "button[id^='cqLookupLookup_Button_']", "type": "button" },
    "cqResult": { "locator": "tbody.cqLookupLookupResultsTable tr:first-child label.radio_label", "type": "radio" },
    "directorEmail": { "locator": "input[id*='LSI_CLPAssistantDirectorEmailAddress_']", "type": "text", "autoGen": "email" },
    "last4SSN": { "locator": "input[id*='LSI_CLPAssistantDirectorLast4SSN_']", "type": "text" },
    "noSsnCheckbox": { "locator": "label.checkbox_label[for*='LSI_CLPAssistantDirectorHasNoSSN_']", "type": "checkbox" },
