    "hours": { "locator": "textarea[id*='LSI_CLPAssistantDirectorHoursOnsite_']", "type": "text" },
    "weeklyCheckbox": { "locator": "label.checkbox_label[for*='LSI_CLPAssistantDirectorHoursFeqIsWeekly_']", "type": "checkbox" },
    "everyOtherWeekCheckbox": { "locator": "label.checkbox_label[for*='LSI_CLPAssistantDirectorHoursFeqIsBiWeekly_']", "type": "checkbox" },
    "otherFrequencyCheckbox": { "locator": "label.checkbox_label[for*='LSI_CLPAssistantDirectorHoursFeqIsOther_']", "type": "checkbox" },
    "hoursNote": { "locator": "input[id*='LSI_CLPAssistantDirectorHoursNote_']", "type": "text" },
    "saveRecord": { "locator": ".modal-footer button.save-close", "type": "button" }
  }
