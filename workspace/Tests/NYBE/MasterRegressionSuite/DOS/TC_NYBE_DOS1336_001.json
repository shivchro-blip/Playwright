{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_DOS1336_001",
      "description": "Sign in through NY.gov, open the Test Dashboard and start the DOS1336 interview (Limited Liability Company (Domestic) Articles of Organization).",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "DOS1336",
        "smoke",
        "TC_NYBE_DOS1336_001"
      ],
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
          "do": [
            {
              "field": "openDropdownButton",
              "click": true
            },
            {
              "field": "testDashboardLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBETestDashboard",
          "do": [
            {
              "field": "startInterviewLink",
              "value": "DOS1336"
            }
          ]
        },
		{ "screen": "NameCheckCorporation", "formData": {
		   "CUSTOMFIELD_WAIT": "3",	
		   "CUSTOMFIELD_CONFIRMTEXT": "Heading|Proposed Entity Name",
		   "LegalNameLLC": null,
		   "CUSTOMFIELD_SAVEFIELD": "corpName|LegalNameLLC|(.+)",
		   "CheckName": "click",
		   "CUSTOMFIELD_WAIT": "3",
		   "TrueName": "DICT.corpName"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "NameVerificationCounty", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Title|ARTICLE OF ORGANIZATION",
		   "CUSTOMFIELD_CONFIRMTEXT|": "LlcName|LLC",
		   "LlcOpeningStatement": "click",
		   "NonEnglishNo": "click",
		   "PurposeClause": "click",
		   "County": "Albany"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "ServiceOfProcess", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Heading|Service of Process",
		   "SopEnterAddress": "click",
		   "SopName": null,
		   "SopAddress1": null,
		   "SopCity": null,
		   "SopZip": null,
		   "RegisteredAgentCheckbox": "click",
		   "RaEnterInfo": "click",
		   "RaName": null,
		   "RaAddress1": null,
		   "RaCity": null,
		   "RaState": "New York",
		   "RaZip": null
		   
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "OptionalStatements", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Title|ARTICLE OF ORGANIZATION",
		   "ManagementStructureCheckbox": "click",
		   "ManagedByManagers": "click",
		   "LlcEffectiveDateCheckbox": "click",
		   "LlcExistenceOnDate": "click",
		   "EffectiveDate": null,
		   "LlcDissolutionCheckbox": "click",
		   "LlcDissolveOnDate": "click",
		   "DurationDate": null,
		   "LlcLiabilityStatementCheckbox": "click"
		} },
		{ "commonAction": "Save and continue"},		
		{ "screen": "OrganizerAttestation", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Heading|Organizer Attestation",
		   "CUSTOMFIELD_CONFIRMTEXT|": "Title|ARTICLE OF ORGANIZATION",
		   "OrganizerName": null,
		   "CUSTOMFIELD_SAVEFIELD": "orgName|OrganizerName|(.+)",
		   "AddressLine1": null,
		   "AddressLine2": "Suite 100",
		   "City": null,
		   "State": "New York",
		   "Zip": null,
		   "Zip4": "1234",
		   "Signature": "DICT.orgName"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "FilerInformation", "formData": {		   
		   "FilerName": null,
		   "AddressLine1": null,
		   "AddressLine2": "Suite 100",
		   "City": null,
		   "State": "New York",
		   "Zip": null,
		   "Zip4": "1234",
		   "Email": null,
		   "CUSTOMFIELD_SAVEFIELD": "filerEmail|Email|(.+)",
		   "ConfirmEmail": "DICT.filerEmail",
		   "CUSTOMFIELD_WAIT": "3"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "FilerInformation", "formData": {
			"CUSTOMFIELD_WAIT": "3",
			"CUSTOMFIELD_WAIT": "3"
		}},		
		{ "commonAction": "Proceed" },
		{ "screen": "CopiesRequest", "formData": {
		   "PlainCopy": "click",
		   "CertifiedCopy": "click",
		   "CertificateOfStatus": "click"
		} },
		{ "commonAction": "Proceed" },
        {
          "commonAction": "Proceed to payment"
        },
        {
          "screen": "PaymentDetails",
          "formData": {
            "checkoutButton": "click"
          }
        },
        {
          "screen": "PaymentDetails",
          "formData": {
            "cardNumber": null,
            "expirationDate": null,            
            "firstName": null,
            "lastName": null,
            "addressLine1": null,
            "city": null,
            "state": null,
            "zipCode": null,
            "email": null,
            "phone": null
          }
        },
        {
          "screen": "PaymentDetails",
          "do": [
            {
              "field": "submitPayment",
              "click": true
            },
            {
              "field": "submitPayment",
              "wait": 5
            }
          ]
        }
      ]
    }
  ]
}
