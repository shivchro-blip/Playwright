{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_DTF17_001_S_CORP",
      "description": "Sign in through NY.gov, open the Test Dashboard and start the DTF17 interview for an S Corporation, complete entity setup, Business Information, Former Owner Information, Financial Information, Physical Mailing Address, Additional Locations, Corporate Ownership, Business Entity Background, Business Associations, Business Activity, Responsible Persons and Attestation, then submit the application.",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "DTF17",
        "smoke",
		"TC_NYBE_DTF17_001_S_CORP"
      ],
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
