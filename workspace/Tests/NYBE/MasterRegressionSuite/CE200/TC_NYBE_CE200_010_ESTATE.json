{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_CE200_010_ESTATE",
      "description": "Sign in through NY.gov, open the Test Dashboard and start the CE200 interview for an Estate, complete entity setup and confirm the error message shown.",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "CE200",
        "smoke",
		"TC_NYBE_CE200_010_ESTATE"
      ],
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
          "do": [
            {
              "field": "openDropdownButton",
              "click": true
            },
            {
              "field": "testDashboardLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBETestDashboard",
          "do": [
            {
              "field": "startInterviewLink",
              "value": "CE200"
            }
          ]
        },
        {
          "screen": "EntityCreation",
          "do": [
            {
              "field": "myBusinessNotListedCell",
              "click": true
            },
            {
              "field": "startApplicationButton",
              "click": true
            }
          ]
        },
        {
          "screen": "EntityTypeSelection",
          "do": [
            {
              "field": "getStartedButton",
              "click": true
            },
            {
              "field": "entityType",
              "value": "Estate"
            },
            {
              "field": "continueButton",
              "click": true
            }
          ]
        },
        { "screen": "EntityInformation", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "heading|Entity Type",
		   "CUSTOMFIELD_CONFIRMTEXT|": "entityType|Estate",
		   "CUSTOMFIELD_CONFIRMTEXT||": "errorMessage|To receive a Certificate of Attestation of Exemption for a Trust or Estate please contact the Workers' Compensation Board's Bureau of Compliance at 1-866-546-9322."
		} }
      ]
    }
  ]
}
