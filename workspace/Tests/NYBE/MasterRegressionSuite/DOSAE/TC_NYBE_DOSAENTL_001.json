{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_DOSAENTL_001",
      "description": "Sign in through NY.gov, open the Test Dashboard and start the DOSAENTL interview (Nail Specialty Trainee).",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "DOSAENTL",
        "smoke",
        "TC_NYBE_DOSAENTL_001"
      ],
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
          "do": [
            {
              "field": "openDropdownButton",
              "click": true
            },
            {
              "field": "testDashboardLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBETestDashboard",
          "do": [
            {
              "field": "startInterviewLink",
              "value": "DOSAENTL"
            }
          ]		  
        },
        {
          "screen": "EntityCreation",
          "do": [
            {
              "field": "myNameNotListedCell",
              "click": true
            },
            {
              "field": "startApplicationButton",
              "click": true
            }
          ]
        },
		{ "commonAction": "Next" },		
		{
		  "screen": "IndividualInformation",
		  "formData": {
			"FirstName": null,
			"LastName": null,
			"SsnArea": null,
			"SsnGroup": null,
			"SsnSerial": null,
			"DobYear": null,
			"DobMonth": null,
			"DobDay": null
		  }
		},
		{ "commonAction": "Save and continue" },
		{ "screen": "IndividualMailingAddress", "formData": { "AddressLine1": null, "City": null, "Zip": null, "County": null } },
		{ "commonAction": "Validate address" },
		{ "screen": "IndividualMailingAddress", "formData": { "Phone": null, "Email": null } },
		{ "commonAction": "Save and continue" },
		{ "commonAction": "Next" },
		{ "commonAction": "Save and continue" },
		{ "screen": "NailTraineeQualifications", "formData": { "HasNailTraineeReg_No": "click" } },
		{ "commonAction": "Save and continue" },
		{
		  "screen": "HealthCertification",
		  "formData": {
			"HealthExamDate": null,
			"PhysicianFullName": null,
			"PhysicianAddress": "1220 Washington Ave, Albany, NY, 12226"
		  }
		},
		{ "commonAction": "Save and continue" },
		{
		  "screen": "SupervisionInformation",
		  "formData": {
			"SupervisorUid": "26LI1298551",
			"SupervisorUidLookup": "click",
			"CUSTOMFIELD_WAIT": "3",
			"BusinessLicenseUid": "AEB-20-01519",
			"BusinessLicenseUidLookup": "click",
			"CUSTOMFIELD_WAIT|2": "3"
		  }
		},
		{ "commonAction": "Save and continue" },{
		  "screen": "ApplicantStatements",
		  "formData": {
			"ChildSupportObligation_No": "click",
			"DomesticViolenceTraining": "click",
			"AEApplicantAffirmation": "click"
		  }
		},
		{ "commonAction": "Save and continue" },
		{
		  "screen": "Questionnaire",
		  "formData": {
			"OrganDonor": "ORGAN_SKIP",
			"RegisterToVote": "VOTE_SKIP"
		  }
		},
		{ "commonAction": "Save and continue" },
		{ "commonAction": "Next" },
		{ "commonAction": "Submit application" }
      ]
    }
  ]
}
