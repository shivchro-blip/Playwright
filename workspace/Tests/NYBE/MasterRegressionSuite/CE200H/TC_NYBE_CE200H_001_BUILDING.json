{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_CE200H_001_BUILDING",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "CE200H",
        "smoke",
        "TC_NYBE_CE200H_001_BUILDING"
      ],
      "description": "Sign in through NY.gov, open the Test Dashboard and start the CE200H interview, complete entity setup, Homeowner Information, Workers Comp Disability, Permit License Contract, Job Site Location, Workers Comp Exemption, Temp Service Agency, Disability Exemption, Application Submitter and Attestation, then submit the application.",
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
          "do": [
            {
              "field": "openDropdownButton",
              "click": true
            },
            {
              "field": "testDashboardLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBETestDashboard",
          "do": [
            {
              "field": "startInterviewLink",
              "value": "CE200H"
            }
          ]
        },
        {
          "screen": "EntityCreation",
          "do": [
            {
              "field": "myNameNotListedCell",
              "click": true
            },
            {
              "field": "startApplicationButton",
              "click": true
            }
          ]
        },
        {
          "screen": "HomeownerInformation",
          "do": [
            {
              "field": "FirstName",
              "value": null
            },
            {
              "field": "LastName",
              "value": null
            },
            {
              "field": "Ssn1",
              "value": null
            },
            {
              "field": "Ssn2",
              "value": null
            },
            {
              "field": "Ssn3",
              "value": null
            },
            {
              "field": "addressLine1",
              "value": "10 Cherry Ave"
            },
            {
              "field": "addressLine2",
              "value": null
            },
            {
              "field": "city",
              "value": "Albany"
            },
            {
              "field": "country",
              "value": "United States"
            },
            {
              "field": "zipCode",
              "value": "12222"
            },
            {
              "field": "county",
              "value": "Albany"
            },
            {
              "field": "BusinessPhone",
              "value": null
            },
            {
              "field": "BusinessEmail",
              "value": null
            }
          ]
        },
        {
          "commonAction": "Validate address"
        },
        {
          "commonAction": "Save and continue"
        },
        { 
          "screen": "WorkersCompDisability", 
          "formData": {
            "WorkersCompNo": "click",
            "DisabilityBenefitNo": "click"
          } 
        },
        {
          "commonAction": "Save and continue"
        },
        { 
          "screen": "PermitLicenseContract", 
          "formData": {
            "ApplyingFor": "Building Permit",
            "IssuingGovAgency": "City of Albany"
          } 
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "screen": "JobSiteLocation",
          "formData": {
            "ProjectFromDate": null,
            "ProjectToDate": null,
            "EstimatedDollar": "$10,001 - $25,000",
            "JobAddressLine1": null,
            "JobCity": null,
            "JobZip": null,
            "JobCounty": null
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "screen": "WorkersCompExemption",
          "formData": {
            "CUSTOMFIELD_CONFIRMTEXT": "Heading|Workers' Compensation Coverage Exemptions",
            "ExemptTempAgencyStaff": "click"
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "screen": "TempServiceAgency",
          "formData": {
            "TempServiceName": null,
            "TempServicePhone": null
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "screen": "DisabilityExemption",
          "formData": {
            "CUSTOMFIELD_CONFIRMTEXT": "Question|disability and paid family leave benefits insurance coverage",
            "DbExemptTempAgencyStaff": "click"
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "screen": "ApplicationSubmitter",
          "formData": {
            "CUSTOMFIELD_CONFIRMTEXT": "Question|Select the individual who is submitting the application",
            "Submitter": "Other",
            "Title": "President",
            "FirstName": null,
            "LastName": null,
            "AddressLine1": null,
            "City": null,
            "Zip": null,
            "Phone": null,
            "Email": null
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "commonAction": "Next"
        },
        {
          "screen": "Attestation",
          "formData": {
            "CUSTOMFIELD_CONFIRMTEXT": "AttestationText|you are attesting to the fact that all information provided is true",
            "IAgree": "click"
          }
        },
        {
          "commonAction": "Save and continue"
        },
        {
          "commonAction": "Submit application"
        }
      ]
    }
  ]
}
