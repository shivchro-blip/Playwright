{
  "testCases": [
    {
      "testCaseID": "TC_NYBE_ECP_001",
      "description": "Sign in through NY.gov, open the Test Dashboard and start the ECP interview (Copies of Filed Documents).",
      "system": "NYBE",
      "env": "dev",
      "module": "licenses",
      "tags": [
        "NYBE",
        "ECP",
        "smoke",
        "TC_NYBE_ECP_001"
      ],
      "steps": [
        {
          "screen": "NYBEHome",
          "do": [
            {
              "field": "loginRegisterLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBELoginRegister",
          "do": [
            {
              "field": "loginHereButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYGovSignIn",
          "do": [
            {
              "field": "username",
              "value": "ENV.NYBE_DEV_USERNAME"
            },
            {
              "field": "password",
              "value": "ENV.NYBE_DEV_PASSWORD"
            },
            {
              "field": "signInButton",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBEDashboard",
          "do": [
            {
              "field": "openDropdownButton",
              "click": true
            },
            {
              "field": "testDashboardLink",
              "click": true
            }
          ]
        },
        {
          "screen": "NYBETestDashboard",
          "do": [
            {
              "field": "startInterviewLink",
              "value": "ECP"
            }
          ]
        },
        {
          "commonAction": "Next"
        },
		{ "screen": "EntitySearch", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Instructions|To search for an entity",
		   "SearchBy": "DOS ID",
		   "SearchValue": "7093092",
		   "SearchButton": "click",
		   "CUSTOMFIELD_WAIT": "3",
		   "SelectResult": "7093092",
		   "CUSTOMFIELD_CONFIRMTEXT|": "SelectedEntity|CULINARY PURSUITS LLC"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "DocumentSelection", "formData": {
		   "SelectAllDocuments": "click",
		   "CUSTOMFIELD_CONFIRMTEXT": "SelectedRows|3 of 3 rows selected",
		   "CopyTypeCertified": "click"
		} },
		{ "commonAction": "Save and continue" },
		{ "screen": "RequestorInformation", "formData": {
		   "CUSTOMFIELD_CONFIRMTEXT": "Heading|Requestor Information",
		   "RequestorName": null,
		   "AddressLine1": null,
		   "AddressLine2": "Suite 100",
		   "City": null,
		   "Country": "United States",
		   "State": "New York",
		   "Zip": null,
		   "Email": null,
		   "CUSTOMFIELD_SAVEFIELD": "requestorEmail|Email|(.+)",
		   "ConfirmEmail": "DICT.requestorEmail"
		} },
		{ "commonAction": "Save and continue" },
        {
          "commonAction": "Next"
        },
        {
          "commonAction": "Proceed to payment"
        },
        {
          "screen": "PaymentDetails",
          "formData": {
            "checkoutButton": "click"
          }
        },
        {
          "screen": "PaymentDetails",
          "formData": {
            "cardNumber": null,
            "expirationDate": null, 
            "firstName": null,
            "lastName": null,
            "addressLine1": null,
            "city": null,
            "state": null,
            "zipCode": null,
            "email": null,
            "phone": null
          }
        },
        {
          "screen": "PaymentDetails",
          "do": [
            {
              "field": "submitPayment",
              "click": true
            },
            {
              "field": "submitPayment",
              "wait": 5
            }
          ]
        }
      ]
    }
  ]
}
