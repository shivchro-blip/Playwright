headlessMode=false
systemConfig=GOOGLE
envConfig=dev
runTags=GOOGLE
snapshots=false
pageWaitUntil=domcontentloaded
TestSuiteLoggerLevel=ERROR
FormHandlerLoggerLevel=ERROR
PageLoggerLevel=ERROR
recording=false
browsers=chrome
slowmo=400
LOG_LEVEL=ERROR
reportsDir=
browserConfigHeight=750
browserConfigMaximized=false
browserConfigWidth=1700
del_allure=true
tracing=false

# Notifications for scheduled runs (Schedules tab). These are secrets: keep them in .env only.
# NOTIFY_SLACK_URL=https://hooks.slack.com/services/...
# NOTIFY_TEAMS_URL=https://<your Teams Workflows "post to channel" webhook URL>
# NOTIFY_WEBHOOK_URL=https://example.com/automateny-hook
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_TLS=starttls
# NOTIFY_SMTP_USER=automateny@example.com
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_SMTP_FROM=automateny@example.com

# AI assist (off by default; turn on with the AI button in the top bar). The key is a secret: keep it in .env only.
# aiAssistEnabled=false
# ANTHROPIC_API_KEY=
